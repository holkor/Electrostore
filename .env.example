# Скопируй этот файл в .env и заполни значения.
# Реальный .env в git НЕ коммитится.

# Порт сервера
PORT=3000

# Секрет для подписи сессионных cookie.
# Сгенерировать новый: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# development | production
NODE_ENV=development
